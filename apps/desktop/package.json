{
  "name": "@daydream/desktop",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/snackbit/daydream.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.node.json --pretty false && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node ./scripts/tauri-dev.mjs",
    "test": "vitest run --exclude 'dist/**' --maxWorkers=2",
    "test:recorder": "vitest run src/features/recorder/scene-layout.test.ts src/features/recorder/recorder-client.test.ts src/features/recorder/recorder-workspace-store.test.ts src/screens/CaptureScreen --maxWorkers=2",
    "test:recorder:coverage": "vitest run --coverage --project unit src/features/recorder/scene-layout.test.ts src/features/recorder/recorder-client.test.ts src/features/recorder/recorder-workspace-store.test.ts --maxWorkers=2",
    "test:recorder:e2e": "cargo test --manifest-path src-tauri/Cargo.toml --locked --jobs 2 public_commands_record_pause_resume_stop -- --test-threads=2",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.node.json --pretty false",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked --jobs 2",
    "test:unit": "vitest run --project unit --maxWorkers=2",
    "test:browser": "vitest run --project browser --maxWorkers=2",
    "test:e2e:native": "sh ./scripts/native-e2e/run.sh",
    "test:dev-watch": "node --test scripts/tauri-dev-watch.test.mjs",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --jobs 2 --all-targets"
  },
  "dependencies": {
    "@daydream/shared": "workspace:*",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@daydream/eslint-config": "workspace:*",
    "@daydream/tsconfig": "workspace:*",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "ffmpeg-static": "5.3.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
