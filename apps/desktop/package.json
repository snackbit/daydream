{
  "name": "@daydream/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.node.json --pretty false && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node ./scripts/tauri-dev.mjs",
    "test": "vitest run --exclude 'dist/**'",
    "test:recorder": "vitest run src/features/recorder/scene-layout.test.ts src/features/recorder/recorder-client.test.ts src/features/recorder/recorder-workspace-store.test.ts src/screens/CaptureScreen.browser.test.tsx",
    "test:recorder:coverage": "vitest run --coverage --project unit src/features/recorder/scene-layout.test.ts src/features/recorder/recorder-client.test.ts src/features/recorder/recorder-workspace-store.test.ts",
    "test:recorder:e2e": "cargo test --manifest-path src-tauri/Cargo.toml public_commands_record_pause_resume_stop_with_fake_capture_and_real_writer",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.node.json --pretty false",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@daydream/shared": "workspace:*",
    "@fontsource-variable/inter": "5.2.8",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-router": "1.170.11",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.17.0",
    "radix-ui": "1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-resizable-panels": "4.11.2",
    "shadcn": "4.10.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@daydream/eslint-config": "workspace:*",
    "@daydream/tsconfig": "workspace:*",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "9.39.4",
    "ffmpeg-static": "5.3.0",
    "playwright": "1.60.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
