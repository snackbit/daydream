{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daydream",
  "version": "0.1.0",
  "identifier": "com.snackbit.daydream",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Daydream",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recordings/**/*"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": { "resources/vad/": "vad/", "resources/embedding/": "embedding/", "resources/licenses/": "licenses/" },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libgstreamer1.0-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-pulseaudio"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gstreamer1-plugins-ugly"
        ]
      }
    }
  }
}
